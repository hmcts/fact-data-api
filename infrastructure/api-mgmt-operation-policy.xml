<policies>
  <inbound>
    <base />
    <!-- Restricts this specific operation to the given set of AAD app roles. -->
    <validate-azure-ad-token
      header-name="Authorization"
      tenant-id="${tenant_id}"
      failed-validation-httpcode="403"
      failed-validation-error-message="Forbidden. Your role does not have access to this operation.">
      <audiences>
        <audience>${audience}</audience>
      </audiences>
      <required-claims>
        <claim name="roles" match="any">
%{ for role in roles ~}
          <value>${role}</value>
%{ endfor ~}
        </claim>
      </required-claims>
    </validate-azure-ad-token>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
